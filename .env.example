# =================================================================
# KIIBOT CTF & SOC Engine - Environment Variables
# =================================================================

# Token Bot Telegram Anda (Wajib)
# Dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="GANTI_DENGAN_TOKEN_ANDA"

# ID Chat Telegram Anda (Wajib untuk keamanan Guardrail)
# Bot HANYA akan merespons pesan dari Chat ID ini.
# Dapatkan dari @userinfobot atau sejenisnya.
TELEGRAM_CHAT_ID="GANTI_DENGAN_CHAT_ID_ANDA"

# -----------------------------------------------------------------
# Konfigurasi Opsional / Tambahan
# KIIBOT_HOME="/root/.kiibot"
